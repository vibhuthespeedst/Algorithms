#include <bits/stdc++.h>
 
using namespace std;
 
int main() {
    // your code goes here
    int n, h, l, r;
    cin >> n >> h >> l >> r;
    int arr[n];
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    vector < vector < int >> dp(n + 1, vector < int > (h, INT_MIN));
 
    dp[0][0] = 0;
 
    for (int i = 1; i <= n; i++) {
        int ele = arr[i - 1];
        for (int j = 0; j < h; j++) {
            dp[i][j] = ((j <= r && j >= l) ? 1 : 0) + max(dp[i - 1][(j - ele + h) % h], dp[i - 1][(j - ele + 1 + h) % h]); //This is how you wrap. 
        }
    }
    int ans = 0;
    for (int i = 0; i < h; i++) {
        ans = max(ans, dp[n][i]);
    }
    cout << ans << endl;
}

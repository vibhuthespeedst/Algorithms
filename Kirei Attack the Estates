#include <bits/stdc++.h>
using namespace std;

#define ll long long


void dfs(ll node, ll par, vector<vector<ll>>&adj, vector<ll> &val, vector<ll> &prefMin, vector<ll> &prefMax){
    if(par!=-1){
        prefMax[node] = max(val[node],val[node]-prefMin[par]);
        prefMin[node] = min(val[node],val[node]-prefMax[par]);
    }
    for(ll &child:adj[node]){
        if(child==par) continue;
        dfs(child,node,adj,val,prefMin,prefMax);
    }
}


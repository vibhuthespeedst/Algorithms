#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int  n;
	cin>>n;
	int arr[n];
	for(int i=0;i<n;i++) cin>>arr[i];
	int pref[n];
	pref[0]=arr[0];
	for(int i=1;i<n;i++) pref[i]=pref[i-1]+arr[i];
	int suff[n];
	suff[n-1]=arr[n-1];
	for(int i=n-2;i>=0;i--) suff[i]=suff[i+1]+arr[i];
	
	for(int i=0;i<n;i++){
	    int part1 = 0;
	    int part2 = 0;
	    if(i>0) part1=pref[i-1];
	    if(i<n) part2=suff[i];
	    cout<<part1+part2<<" ";
	}
	cout<<endl;

}
